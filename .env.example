# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- ArangoDB ---
# Local Docker (starter/run.sh sets these itself), or any ArangoDB 3.12 deployment.
ARANGO_ENDPOINT=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DATABASE=gdelt_market
ARANGO_VERIFY_SSL=true
# Optional: other databases on a shared cluster that db_admin.py must never touch.
ARANGO_PROTECTED_DBS=
# Optional: documents headline_figures.py should not flag (they record a past day).
HEADLINE_FROZEN=

# --- Google Cloud / BigQuery (GDELT source) ---
# GDELT public dataset: project gdelt-bq, dataset gdeltv2 (Events + GKG).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GCS_BUCKET=                      # staging bucket for BigQuery exports

# --- Market price data (for correlatesWith / affects event-study edges) ---
# yfinance for prices + FRED for macro. Both free.
# Tradeoffs, limits, and the licensed-vendor path: docs/market-data.md
MARKET_DATA_PROVIDER=yfinance    # documentation only — no code reads this
MARKET_DATA_API_KEY=             # unused by yfinance; FRED fallback slot
# Free key, issued instantly: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it the macro series are skipped, and affects edges are built from
# commodity futures alone (no rates/inflation channel). Needs `pip install fredapi`.
FRED_API_KEY=

# --- Optional: LLM provider for the NL what-if front end (arango-cypher-py) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
